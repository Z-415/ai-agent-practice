# ── 虚拟环境（几百 MB，绝对不要提交到 Git）──────────────────────────
.venv/
venv/
env/

# ── Python 缓存 ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/

